{
  "$defs": {
    "Axis": {
      "description": "A world/local coordinate axis, serialized as `\"x\"`, `\"y\"`, `\"z\"`.",
      "oneOf": [
        {
          "const": "x",
          "description": "X axis.",
          "type": "string"
        },
        {
          "const": "y",
          "description": "Y axis.",
          "type": "string"
        },
        {
          "const": "z",
          "description": "Z axis (default, matching 1.0 `HoleFeature.axis`).",
          "type": "string"
        }
      ]
    },
    "AxisDir": {
      "description": "A signed axis direction, serialized as `\"+x\"`, `\"-x\"`, … `\"-z\"` (spec §1.1).\n\nDeclaration order (`+x, -x, +y, -y, +z, -z`) is the canonical order used by §5.4.",
      "oneOf": [
        {
          "const": "+x",
          "description": "`+x`",
          "type": "string"
        },
        {
          "const": "-x",
          "description": "`-x`",
          "type": "string"
        },
        {
          "const": "+y",
          "description": "`+y`",
          "type": "string"
        },
        {
          "const": "-y",
          "description": "`-y`",
          "type": "string"
        },
        {
          "const": "+z",
          "description": "`+z`",
          "type": "string"
        },
        {
          "const": "-z",
          "description": "`-z`",
          "type": "string"
        }
      ]
    },
    "Layer": {
      "description": "Which validation layer produced an issue (§9.1, §9.4).",
      "oneOf": [
        {
          "const": "analytic",
          "description": "Rust analytic validator (default).",
          "type": "string"
        },
        {
          "const": "kernel",
          "description": "Geometry-kernel validation in the renderer sidecar.",
          "type": "string"
        }
      ]
    },
    "ResolvedComponent": {
      "additionalProperties": false,
      "description": "World placement of one component.",
      "properties": {
        "defaulted_axes": {
          "description": "Axes defaulted to 0 by the under-constrained rule (§5.5 step 4), in axis order.",
          "items": {
            "$ref": "#/$defs/Axis"
          },
          "type": "array"
        },
        "origin": {
          "description": "World translation `t` (the frame port's world position for independent components).",
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "x_axis": {
          "$ref": "#/$defs/AxisDir",
          "description": "World direction of local X."
        },
        "z_axis": {
          "$ref": "#/$defs/AxisDir",
          "description": "World direction of local Z."
        }
      },
      "required": [
        "origin",
        "x_axis",
        "z_axis",
        "defaulted_axes"
      ],
      "type": "object"
    },
    "ResolvedHole": {
      "additionalProperties": false,
      "description": "Solved hole (§7).",
      "properties": {
        "cutter_end": {
          "description": "Main-hole cutter end (world).",
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "cutter_start": {
          "description": "Main-hole cutter start (world).",
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "diameter": {
          "description": "Main-hole diameter.",
          "format": "double",
          "type": "number"
        },
        "direction": {
          "$ref": "#/$defs/AxisDir",
          "description": "Inward cut direction."
        }
      },
      "required": [
        "direction",
        "cutter_start",
        "cutter_end",
        "diameter"
      ],
      "type": "object"
    },
    "ResolvedPort": {
      "description": "A port's world geometry, discriminated by `type` (§3.4).",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "`point`",
          "properties": {
            "position": {
              "description": "World position.",
              "items": {
                "format": "double",
                "type": "number"
              },
              "maxItems": 3,
              "minItems": 3,
              "type": "array"
            },
            "type": {
              "const": "point",
              "type": "string"
            }
          },
          "required": [
            "type",
            "position"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "`axis`",
          "properties": {
            "direction": {
              "$ref": "#/$defs/AxisDir",
              "description": "World direction."
            },
            "position": {
              "description": "World position.",
              "items": {
                "format": "double",
                "type": "number"
              },
              "maxItems": 3,
              "minItems": 3,
              "type": "array"
            },
            "type": {
              "const": "axis",
              "type": "string"
            }
          },
          "required": [
            "type",
            "position",
            "direction"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "`face`",
          "properties": {
            "extent": {
              "description": "`[length along u, length along v]`.",
              "items": {
                "format": "double",
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            "normal": {
              "$ref": "#/$defs/AxisDir",
              "description": "Outward normal."
            },
            "origin": {
              "description": "Face center.",
              "items": {
                "format": "double",
                "type": "number"
              },
              "maxItems": 3,
              "minItems": 3,
              "type": "array"
            },
            "type": {
              "const": "face",
              "type": "string"
            },
            "u": {
              "$ref": "#/$defs/AxisDir",
              "description": "In-face u direction."
            },
            "v": {
              "$ref": "#/$defs/AxisDir",
              "description": "In-face v direction (`u × v = normal`)."
            }
          },
          "required": [
            "type",
            "origin",
            "normal",
            "u",
            "v",
            "extent"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "`region` (axis-aligned bounding box).",
          "properties": {
            "max": {
              "description": "Maximum corner.",
              "items": {
                "format": "double",
                "type": "number"
              },
              "maxItems": 3,
              "minItems": 3,
              "type": "array"
            },
            "min": {
              "description": "Minimum corner.",
              "items": {
                "format": "double",
                "type": "number"
              },
              "maxItems": 3,
              "minItems": 3,
              "type": "array"
            },
            "type": {
              "const": "region",
              "type": "string"
            }
          },
          "required": [
            "type",
            "min",
            "max"
          ],
          "type": "object"
        }
      ]
    },
    "Role": {
      "description": "Agent roles (§8.1, §8.3). Used as issue `owner` and as the patch `agent`.",
      "oneOf": [
        {
          "const": "space_planner",
          "description": "Space planner: reserved-class Empties, parameters.",
          "type": "string"
        },
        {
          "const": "component_smith",
          "description": "Component smith: Dots, Lines, Planes, Volumes, `cut` Empties.",
          "type": "string"
        },
        {
          "const": "joiner",
          "description": "Joiner: constraints.",
          "type": "string"
        },
        {
          "const": "assembler",
          "description": "Assembler: parts, bodies, assemblies.",
          "type": "string"
        }
      ]
    },
    "SchemaVersion2": {
      "description": "`schema_version: \"2.0\"`.",
      "oneOf": [
        {
          "const": "2.0",
          "description": "`\"2.0\"`",
          "type": "string"
        }
      ]
    },
    "Severity": {
      "description": "Issue severity.",
      "oneOf": [
        {
          "const": "error",
          "description": "Blocks rendering (and, for P-class codes, the patch).",
          "type": "string"
        },
        {
          "const": "warning",
          "description": "Does not block; sets `review_required`.",
          "type": "string"
        },
        {
          "const": "info",
          "description": "Informational.",
          "type": "string"
        }
      ]
    },
    "ValidationIssue": {
      "additionalProperties": false,
      "description": "ValidationIssue 2.0 (§9.1).",
      "properties": {
        "code": {
          "description": "Issue code (see [`codes::Code`]); kept as a string so 1.0/kernel reports round-trip.",
          "type": "string"
        },
        "feature_index": {
          "default": null,
          "description": "1.0 feature index, `null` in 2.0 issues.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "layer": {
          "$ref": "#/$defs/Layer",
          "default": "analytic",
          "description": "Producing layer."
        },
        "message": {
          "description": "Fixed-template message; may embed only ids, numbers and template text (§9.1).",
          "type": "string"
        },
        "owner": {
          "anyOf": [
            {
              "$ref": "#/$defs/Role"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Role that should fix the issue."
        },
        "related": {
          "default": [],
          "description": "Other involved ids.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "severity": {
          "$ref": "#/$defs/Severity",
          "description": "Severity."
        },
        "target": {
          "default": null,
          "description": "Component/constraint/part id or `id:field` the issue is about.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "severity",
        "code",
        "message"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The whole `resolved.json`.",
  "properties": {
    "components": {
      "additionalProperties": false,
      "description": "World placement of every component.",
      "patternProperties": {
        "^[a-z][a-z0-9_]{0,31}$": {
          "$ref": "#/$defs/ResolvedComponent"
        }
      },
      "type": "object"
    },
    "holes": {
      "additionalProperties": false,
      "description": "Hole cut directions and main-hole cutter spans (§7).",
      "patternProperties": {
        "^[a-z][a-z0-9_]{0,31}$": {
          "$ref": "#/$defs/ResolvedHole"
        }
      },
      "type": "object"
    },
    "issues": {
      "description": "Solver diagnostics only (§5.4, §5.5, §7.1 codes).",
      "items": {
        "$ref": "#/$defs/ValidationIssue"
      },
      "type": "array"
    },
    "ports": {
      "additionalProperties": false,
      "description": "Ports referenced by constraints plus every component's frame port.",
      "patternProperties": {
        "^[a-z][a-z0-9_]{0,31}\\.[a-z][a-z0-9_]{0,31}$": {
          "$ref": "#/$defs/ResolvedPort"
        }
      },
      "type": "object"
    },
    "revision": {
      "description": "Document revision that was solved.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion2",
      "description": "`\"2.0\"`."
    }
  },
  "required": [
    "schema_version",
    "revision",
    "components",
    "ports",
    "holes",
    "issues"
  ],
  "title": "Resolved",
  "type": "object"
}
