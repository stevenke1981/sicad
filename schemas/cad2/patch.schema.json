{
  "$defs": {
    "Assembly": {
      "additionalProperties": false,
      "description": "An assembly (§6.2).",
      "properties": {
        "children": {
          "description": "1–32 N2 ids (parts or assemblies).",
          "items": {
            "$ref": "#/$defs/Id"
          },
          "maxItems": 32,
          "minItems": 1,
          "type": "array"
        },
        "id": {
          "$ref": "#/$defs/Id",
          "description": "N2 identifier."
        },
        "name": {
          "description": "1–80 chars.",
          "maxLength": 80,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "children"
      ],
      "type": "object"
    },
    "Axis": {
      "description": "A world/local coordinate axis, serialized as `\"x\"`, `\"y\"`, `\"z\"`.",
      "oneOf": [
        {
          "const": "x",
          "description": "X axis.",
          "type": "string"
        },
        {
          "const": "y",
          "description": "Y axis.",
          "type": "string"
        },
        {
          "const": "z",
          "description": "Z axis (default, matching 1.0 `HoleFeature.axis`).",
          "type": "string"
        }
      ]
    },
    "AxisDir": {
      "description": "A signed axis direction, serialized as `\"+x\"`, `\"-x\"`, … `\"-z\"` (spec §1.1).\n\nDeclaration order (`+x, -x, +y, -y, +z, -z`) is the canonical order used by §5.4.",
      "oneOf": [
        {
          "const": "+x",
          "description": "`+x`",
          "type": "string"
        },
        {
          "const": "-x",
          "description": "`-x`",
          "type": "string"
        },
        {
          "const": "+y",
          "description": "`+y`",
          "type": "string"
        },
        {
          "const": "-y",
          "description": "`-y`",
          "type": "string"
        },
        {
          "const": "+z",
          "description": "`+z`",
          "type": "string"
        },
        {
          "const": "-z",
          "description": "`-z`",
          "type": "string"
        }
      ]
    },
    "BodyOp": {
      "additionalProperties": false,
      "description": "`{op, component}` (§6.1).",
      "properties": {
        "component": {
          "$ref": "#/$defs/Id",
          "description": "Component id."
        },
        "op": {
          "$ref": "#/$defs/BodyOpKind",
          "description": "Boolean op."
        }
      },
      "required": [
        "op",
        "component"
      ],
      "type": "object"
    },
    "BodyOpKind": {
      "description": "Body boolean operation (§6.1).",
      "oneOf": [
        {
          "const": "add",
          "description": "Union with a Volume.",
          "type": "string"
        },
        {
          "const": "cut",
          "description": "Subtract a `cut` Empty.",
          "type": "string"
        },
        {
          "const": "intersect",
          "description": "Intersect with a Volume or `envelope` Empty.",
          "type": "string"
        }
      ]
    },
    "ChamferFeature": {
      "additionalProperties": false,
      "description": "`{kind: \"chamfer\", distance, selector}` (1.0 `ChamferFeature`).",
      "properties": {
        "distance": {
          "description": "`Dim`.",
          "exclusiveMinimum": 0.0,
          "maximum": 100000.0,
          "type": "number"
        },
        "kind": {
          "$ref": "#/$defs/ChamferTag",
          "default": "chamfer",
          "description": "Always `\"chamfer\"`."
        },
        "selector": {
          "$ref": "#/$defs/EdgeSelector",
          "default": "vertical",
          "description": "Edge selector."
        }
      },
      "required": [
        "distance"
      ],
      "type": "object"
    },
    "ChamferTag": {
      "description": "`kind: \"chamfer\"`.",
      "oneOf": [
        {
          "const": "chamfer",
          "description": "`\"chamfer\"`",
          "type": "string"
        }
      ]
    },
    "ComponentInput": {
      "description": "Wire form of [`ComponentInput`] (no `provenance`).",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/Id"
            },
            "kind": {
              "const": "empty",
              "type": "string"
            },
            "label": {
              "default": null,
              "maxLength": 80,
              "type": [
                "string",
                "null"
              ]
            },
            "role": {
              "$ref": "#/$defs/EmptyRole"
            },
            "shape": {
              "$ref": "#/$defs/EmptyShape"
            }
          },
          "required": [
            "kind",
            "id",
            "role",
            "shape"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/Id"
            },
            "kind": {
              "const": "dot",
              "type": "string"
            },
            "label": {
              "default": null,
              "maxLength": 80,
              "type": [
                "string",
                "null"
              ]
            },
            "shape": {
              "$ref": "#/$defs/DotShape"
            }
          },
          "required": [
            "kind",
            "id",
            "shape"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/Id"
            },
            "kind": {
              "const": "line",
              "type": "string"
            },
            "label": {
              "default": null,
              "maxLength": 80,
              "type": [
                "string",
                "null"
              ]
            },
            "shape": {
              "$ref": "#/$defs/LineShape"
            }
          },
          "required": [
            "kind",
            "id",
            "shape"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/Id"
            },
            "kind": {
              "const": "plane",
              "type": "string"
            },
            "label": {
              "default": null,
              "maxLength": 80,
              "type": [
                "string",
                "null"
              ]
            },
            "shape": {
              "$ref": "#/$defs/PlaneShape"
            }
          },
          "required": [
            "kind",
            "id",
            "shape"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/Id"
            },
            "kind": {
              "const": "volume",
              "type": "string"
            },
            "label": {
              "default": null,
              "maxLength": 80,
              "type": [
                "string",
                "null"
              ]
            },
            "shape": {
              "$ref": "#/$defs/VolumeShape"
            }
          },
          "required": [
            "kind",
            "id",
            "shape"
          ],
          "type": "object"
        }
      ]
    },
    "Constraint": {
      "additionalProperties": false,
      "description": "A constraint (§5.1): `{id, kind, a, b, value, u, v, frame}`.",
      "properties": {
        "a": {
          "$ref": "#/$defs/PortRef",
          "description": "First port (for `fixed`: the frame port)."
        },
        "b": {
          "anyOf": [
            {
              "$ref": "#/$defs/PortRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Second port; `null` exactly for `fixed`."
        },
        "frame": {
          "anyOf": [
            {
              "$ref": "#/$defs/Frame"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "`fixed` only (required there)."
        },
        "id": {
          "$ref": "#/$defs/Id",
          "description": "N1 identifier."
        },
        "kind": {
          "$ref": "#/$defs/ConstraintKind",
          "description": "Constraint kind."
        },
        "u": {
          "default": null,
          "description": "`Coord | null` — `on_face` only.",
          "maximum": 100000.0,
          "minimum": -100000.0,
          "type": [
            "number",
            "null"
          ]
        },
        "v": {
          "default": null,
          "description": "`Coord | null` — `on_face` only.",
          "maximum": 100000.0,
          "minimum": -100000.0,
          "type": [
            "number",
            "null"
          ]
        },
        "value": {
          "default": null,
          "description": "`Coord | null` — see [`ConstraintKind::uses_value`].",
          "maximum": 100000.0,
          "minimum": -100000.0,
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "a"
      ],
      "type": "object"
    },
    "ConstraintKind": {
      "description": "Constraint `kind` (§5.1).",
      "oneOf": [
        {
          "const": "fixed",
          "description": "Root a frame port at `frame`.",
          "type": "string"
        },
        {
          "const": "coincident",
          "description": "point–point.",
          "type": "string"
        },
        {
          "const": "on_face",
          "description": "point–face at `(u, v)`.",
          "type": "string"
        },
        {
          "const": "coaxial",
          "description": "axis–axis.",
          "type": "string"
        },
        {
          "const": "mate",
          "description": "face–face, opposite normals, gap `value ≥ 0`.",
          "type": "string"
        },
        {
          "const": "flush",
          "description": "face–face, same normal, offset `value`.",
          "type": "string"
        },
        {
          "const": "distance",
          "description": "point–face or face–face signed distance along `n_b`.",
          "type": "string"
        },
        {
          "const": "inside",
          "description": "region–region containment (check only).",
          "type": "string"
        },
        {
          "const": "clearance",
          "description": "region–region minimum gap ≥ `value` (check only).",
          "type": "string"
        }
      ]
    },
    "DotShape": {
      "description": "Dot shapes.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "`point` (no fields).",
          "properties": {
            "kind": {
              "const": "point",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "EdgeSelector": {
      "description": "Edge selector for fillets and chamfers; default `vertical`.",
      "oneOf": [
        {
          "const": "all",
          "description": "`all`",
          "type": "string"
        },
        {
          "const": "vertical",
          "description": "`vertical` (default)",
          "type": "string"
        },
        {
          "const": "top",
          "description": "`top`",
          "type": "string"
        },
        {
          "const": "bottom",
          "description": "`bottom`",
          "type": "string"
        }
      ]
    },
    "EmptyRole": {
      "description": "Empty `role` (§3.1), required on and exclusive to `kind = \"empty\"`.",
      "oneOf": [
        {
          "const": "cut",
          "description": "Subtracted from a part body.",
          "type": "string"
        },
        {
          "const": "reserve",
          "description": "Space reserved for something (PCB, connector, …).",
          "type": "string"
        },
        {
          "const": "keep_out",
          "description": "Space no solid may enter.",
          "type": "string"
        },
        {
          "const": "envelope",
          "description": "Bounding envelope; may be `intersect`ed by several parts.",
          "type": "string"
        }
      ]
    },
    "EmptyShape": {
      "description": "Empty shapes, discriminated by `shape.kind`.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "`box`",
          "properties": {
            "height": {
              "description": "Along local Z.",
              "exclusiveMinimum": 0.0,
              "maximum": 100000.0,
              "type": "number"
            },
            "kind": {
              "const": "box",
              "type": "string"
            },
            "length": {
              "description": "Along local X.",
              "exclusiveMinimum": 0.0,
              "maximum": 100000.0,
              "type": "number"
            },
            "width": {
              "description": "Along local Y.",
              "exclusiveMinimum": 0.0,
              "maximum": 100000.0,
              "type": "number"
            }
          },
          "required": [
            "kind",
            "length",
            "width",
            "height"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "`cylinder`",
          "properties": {
            "diameter": {
              "description": "Diameter.",
              "exclusiveMinimum": 0.0,
              "maximum": 100000.0,
              "type": "number"
            },
            "height": {
              "description": "Along local Z.",
              "exclusiveMinimum": 0.0,
              "maximum": 100000.0,
              "type": "number"
            },
            "kind": {
              "const": "cylinder",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "diameter",
            "height"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "`hole`",
          "properties": {
            "axis": {
              "$ref": "#/$defs/Axis",
              "default": "z",
              "description": "Local hole axis, default `z`."
            },
            "counterbore_depth": {
              "description": "`Dim | null`.",
              "exclusiveMinimum": 0.0,
              "maximum": 100000.0,
              "type": [
                "number",
                "null"
              ]
            },
            "counterbore_diameter": {
              "description": "`Dim | null`.",
              "exclusiveMinimum": 0.0,
              "maximum": 100000.0,
              "type": [
                "number",
                "null"
              ]
            },
            "countersink_angle": {
              "description": "`0 < x < 180 | null`.",
              "exclusiveMaximum": 180.0,
              "exclusiveMinimum": 0.0,
              "type": [
                "number",
                "null"
              ]
            },
            "countersink_diameter": {
              "description": "`Dim | null`.",
              "exclusiveMinimum": 0.0,
              "maximum": 100000.0,
              "type": [
                "number",
                "null"
              ]
            },
            "depth": {
              "description": "`Dim | null`; required for `blind`.",
              "exclusiveMinimum": 0.0,
              "maximum": 100000.0,
              "type": [
                "number",
                "null"
              ]
            },
            "diameter": {
              "description": "`Dim`.",
              "exclusiveMinimum": 0.0,
              "maximum": 100000.0,
              "type": "number"
            },
            "hole_type": {
              "$ref": "#/$defs/HoleType",
              "default": "through",
              "description": "Default `through`."
            },
            "kind": {
              "const": "hole",
              "type": "string"
            },
            "thread": {
              "description": "`^M\\d{1,3}(\\.\\d)?(x\\d(\\.\\d{1,2})?)?$ | null`.",
              "pattern": "^M\\d{1,3}(\\.\\d)?(x\\d(\\.\\d{1,2})?)?$",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "diameter",
            "depth",
            "counterbore_diameter",
            "counterbore_depth",
            "countersink_diameter",
            "countersink_angle"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "`of`",
          "properties": {
            "kind": {
              "const": "of",
              "type": "string"
            },
            "source": {
              "$ref": "#/$defs/Id",
              "description": "Volume `id`."
            }
          },
          "required": [
            "kind",
            "source"
          ],
          "type": "object"
        }
      ]
    },
    "ExprText": {
      "maxLength": 160,
      "minLength": 1,
      "type": "string"
    },
    "FieldRef": {
      "pattern": "^[a-z][a-z0-9_]{0,31}:[a-z][a-z0-9_]{0,31}$",
      "type": "string"
    },
    "FilletFeature": {
      "additionalProperties": false,
      "description": "`{kind: \"fillet\", radius, selector}` (1.0 `FilletFeature`).",
      "properties": {
        "kind": {
          "$ref": "#/$defs/FilletTag",
          "default": "fillet",
          "description": "Always `\"fillet\"`."
        },
        "radius": {
          "description": "`Dim`.",
          "exclusiveMinimum": 0.0,
          "maximum": 100000.0,
          "type": "number"
        },
        "selector": {
          "$ref": "#/$defs/EdgeSelector",
          "default": "vertical",
          "description": "Edge selector."
        }
      },
      "required": [
        "radius"
      ],
      "type": "object"
    },
    "FilletTag": {
      "description": "`kind: \"fillet\"`.",
      "oneOf": [
        {
          "const": "fillet",
          "description": "`\"fillet\"`",
          "type": "string"
        }
      ]
    },
    "Frame": {
      "additionalProperties": false,
      "description": "Wire form of [`Frame`] (also its JSON Schema).",
      "properties": {
        "origin": {
          "items": {
            "maximum": 100000.0,
            "minimum": -100000.0,
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "x_axis": {
          "$ref": "#/$defs/AxisDir"
        },
        "z_axis": {
          "$ref": "#/$defs/AxisDir"
        }
      },
      "required": [
        "origin",
        "x_axis",
        "z_axis"
      ],
      "type": "object"
    },
    "HoleType": {
      "description": "Hole subtype (1.0 `HoleType`); default `through`.",
      "oneOf": [
        {
          "const": "through",
          "description": "`through` (default)",
          "type": "string"
        },
        {
          "const": "blind",
          "description": "`blind` — requires `depth`",
          "type": "string"
        },
        {
          "const": "clearance",
          "description": "`clearance`",
          "type": "string"
        },
        {
          "const": "tapped",
          "description": "`tapped`",
          "type": "string"
        },
        {
          "const": "counterbore",
          "description": "`counterbore` — requires `counterbore_diameter` and `counterbore_depth`",
          "type": "string"
        },
        {
          "const": "countersink",
          "description": "`countersink` — requires `countersink_diameter` and `countersink_angle`",
          "type": "string"
        }
      ]
    },
    "Id": {
      "maxLength": 32,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_]{0,31}$",
      "type": "string"
    },
    "LineShape": {
      "description": "Line shapes (all derived components).",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "`segment`",
          "properties": {
            "end": {
              "$ref": "#/$defs/Id",
              "description": "End Dot."
            },
            "kind": {
              "const": "segment",
              "type": "string"
            },
            "start": {
              "$ref": "#/$defs/Id",
              "description": "Start Dot."
            }
          },
          "required": [
            "kind",
            "start",
            "end"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "`polyline`",
          "properties": {
            "closed": {
              "description": "Whether the polyline is closed.",
              "type": "boolean"
            },
            "kind": {
              "const": "polyline",
              "type": "string"
            },
            "points": {
              "description": "Dot ids, 2–64.",
              "items": {
                "$ref": "#/$defs/Id"
              },
              "maxItems": 64,
              "minItems": 2,
              "type": "array"
            }
          },
          "required": [
            "kind",
            "points",
            "closed"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "`arc`",
          "properties": {
            "end": {
              "$ref": "#/$defs/Id",
              "description": "End Dot."
            },
            "kind": {
              "const": "arc",
              "type": "string"
            },
            "start": {
              "$ref": "#/$defs/Id",
              "description": "Start Dot."
            },
            "through": {
              "$ref": "#/$defs/Id",
              "description": "A Dot the arc passes through."
            }
          },
          "required": [
            "kind",
            "start",
            "through",
            "end"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "`circle`",
          "properties": {
            "center": {
              "$ref": "#/$defs/Id",
              "description": "Center Dot."
            },
            "diameter": {
              "description": "`Dim`.",
              "exclusiveMinimum": 0.0,
              "maximum": 100000.0,
              "type": "number"
            },
            "kind": {
              "const": "circle",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "center",
            "diameter"
          ],
          "type": "object"
        }
      ]
    },
    "Material": {
      "description": "Part material (1.0 `Material`).",
      "oneOf": [
        {
          "const": "aluminum",
          "description": "`aluminum`",
          "type": "string"
        },
        {
          "const": "steel",
          "description": "`steel`",
          "type": "string"
        },
        {
          "const": "stainless_steel",
          "description": "`stainless_steel`",
          "type": "string"
        },
        {
          "const": "plastic",
          "description": "`plastic`",
          "type": "string"
        },
        {
          "const": "wood",
          "description": "`wood`",
          "type": "string"
        },
        {
          "const": "other",
          "description": "`other`",
          "type": "string"
        }
      ]
    },
    "Parameter": {
      "additionalProperties": false,
      "description": "A named parameter (§4.1). `name` is in namespace N3 and may not be `min` / `max`.",
      "properties": {
        "max": {
          "default": null,
          "description": "Optional upper bound.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "min": {
          "default": null,
          "description": "Optional lower bound (`parameter_out_of_range` is a validator code).",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "name": {
          "$ref": "#/$defs/Id",
          "description": "Parameter name (N3)."
        },
        "note": {
          "default": null,
          "description": "≤ 120 chars.",
          "maxLength": 120,
          "type": [
            "string",
            "null"
          ]
        },
        "value": {
          "description": "Current value.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "type": "object"
    },
    "Part": {
      "additionalProperties": false,
      "description": "A part (§6.2).",
      "properties": {
        "body": {
          "description": "Boolean recipe, 1–128 ops, first must be `add`.",
          "items": {
            "$ref": "#/$defs/BodyOp"
          },
          "maxItems": 128,
